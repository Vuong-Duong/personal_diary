# Server Configuration
PORT=8000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/personal_diary_sdn

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_change_this_in_production
JWT_EXPIRES_IN=15m

# Refresh Token Configuration
REFRESH_TOKEN_SECRET=your_refresh_token_secret_key_change_this_in_production
REFRESH_TOKEN_EXPIRES_IN=7d
REFRESH_TOKEN_COOKIE_NAME=refreshToken

# Email Configuration (SendGrid)
SENDGRID_API_KEY=your_sendgrid_api_key_here
MAIL_FROM=your-email@example.com
SENDGRID_FROM=your-email@example.com

# Frontend Configuration
FRONTEND_URL=http://localhost:3000

# Rate Limiting (optional)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# API Documentation
API_VERSION=1.0.0
API_TITLE=Personal Diary API
API_DESCRIPTION=REST API for Personal Diary - a social media platform for sharing diary posts

# Logging (optional)
LOG_LEVEL=info
